{
  "__comment": "TIC Grafana Dashboard — import into Grafana 10+. Data source: Prometheus named 'prometheus'.",
  "title": "Threat Intel Correlator — Operations",
  "uid": "tic-ops-v1",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "datasource": "prometheus",
        "query": "label_values(tic_provider_requests_total, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Enrichment Request Rate (RED — Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(tic_provider_requests_total{provider=~\"$provider\"}[5m])) by (provider)",
          "legendFormat": "{{provider}} req/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 2,
      "title": "Enrichment Error Rate (RED — Errors)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(tic_provider_errors_total{provider=~\"$provider\"}[5m])) by (provider, error_type)",
          "legendFormat": "{{provider}} / {{error_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "thresholdsStyle": { "mode": "area" } }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.1, "color": "red" }] } } }
    },
    {
      "id": 3,
      "title": "Enrichment Error Rate % (SLO: <5%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "100 * rate(tic_enrichment_errors_total[5m]) / rate(tic_enrichment_requests_total[5m])",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 5, "color": "yellow" }, { "value": 20, "color": "red" }] }
        }
      }
    },
    {
      "id": 4,
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "tic_circuit_breaker_state",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "OPEN", "color": "red" } }, "type": "value" }],
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "100 * rate(tic_cache_hits_total{provider=~\"$provider\"}[5m]) / (rate(tic_cache_hits_total{provider=~\"$provider\"}[5m]) + rate(tic_cache_misses_total{provider=~\"$provider\"}[5m]))",
          "legendFormat": "{{provider}} hit %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 6,
      "title": "Rate Limit Exceeded",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "rate(tic_rate_limit_exceeded_total[5m])",
          "legendFormat": "{{endpoint}} rejections/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "fixedColor": "orange", "mode": "fixed" } } }
    },
    {
      "id": 7,
      "title": "IOCs Processed by Type",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(tic_iocs_processed_total[1h])) by (ioc_type)",
          "legendFormat": "{{ioc_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8,
      "title": "Findings by Severity",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(tic_findings_total[1h])) by (severity)",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "overrides": [
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "low" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      }
    }
  ]
}
