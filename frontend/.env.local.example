# Copy to .env.local before running `npm run dev`.
# The Next.js app calls the local FastAPI backend at this base URL.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Targeting a HOSTED backend (the public demo) instead of localhost requires
# both of the following. Without the opt-in, a remote NEXT_PUBLIC_API_BASE is
# ignored and the client falls back to 127.0.0.1:8000 -- so a stray or
# copy-pasted value can never ship local sweep data to someone else's host.
# Remote backends must be https: uploads carry IPs, hostnames and usernames.
#
#   NEXT_PUBLIC_API_BASE=https://your-backend.example.com
#   NEXT_PUBLIC_ALLOW_REMOTE_API=true
#
# Both are baked into the client bundle at BUILD time, so set them in the
# hosting provider's build environment (e.g. Vercel project settings), not at
# runtime. The backend must also list this frontend's origin in
# TIC_API_CORS_ORIGINS, or the browser blocks every call.
